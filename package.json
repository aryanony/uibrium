{
  "name": "uibrium-monorepo",
  "private": true,
  "author": "Aaryan Gupta (https://github.com/aryanony)",
  "license": "MIT",
  "version": "0.0.0",
  "description": "UiBrium — Build Smarter, Ship Faster. A production-grade React UI Component Library.",
  "scripts": {
    "dev": "pnpm --filter \"@uibrium/*\" --parallel dev",
    "dev:docs": "pnpm --filter @uibrium/docs dev",
    "build": "turbo run build",
    "build:docs": "pnpm --filter @uibrium/docs build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "generate:stories": "node scripts/generate-stories.mjs",
    "storybook": "pnpm generate:stories && storybook dev -p 6006",
    "build-storybook": "pnpm generate:stories && storybook build",
    "typecheck": "turbo run typecheck",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-interactions": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/blocks": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^9.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.2.0",
    "storybook": "^8.4.0",
    "turbo": "^2.9.12",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@types/react": "18.2.79",
      "@types/react-dom": "18.2.25"
    }
  }
}
